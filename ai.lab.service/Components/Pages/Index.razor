@page "/"
@using Microsoft.AspNetCore.SignalR.Client
@inject NavigationManager Navigation

<h3>AI Lab Chat</h3>

<div class="chat-window">
    @foreach (var message in messages)
    {
        <div class="@(message.IsUser ? "user-message" : "ai-message")">
            @message.Text
        </div>
    }

    @if (isStreaming)
    {
        <div class="ai-message">@streamBuffer</div>
    }
</div>

<div class="chat-input">
    <input @bind="userPrompt" @bind:event="oninput" placeholder="Type your prompt..." />
    <select @bind="selectedModel">
        <option value="phi-2">Phi-2</option>
        <option value="deepseek">DeepSeek</option>
    </select>
    <button @onclick="SendPrompt">Send</button>
</div>

@code {
    private HubConnection? hubConnection;
    private string userPrompt = "";
    private string selectedModel = "phi-2";
    private bool isStreaming = false;
    private string streamBuffer = "";
    private List<ChatMessage> messages = [];

    protected override async Task OnInitializedAsync()
    {
        hubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/aichatHub"))
            .Build();

        hubConnection.On<string>("ReceivePartialResponse", chunk =>
        {
            isStreaming = true;
            streamBuffer += chunk;
            StateHasChanged();
        });

        hubConnection.On<string>("ReceiveResponse", full =>
        {
            isStreaming = false;
            messages.Add(new ChatMessage { Text = full, IsUser = false });
            streamBuffer = "";
            StateHasChanged();
        });

        hubConnection.On<object>("ReceiveError", error =>
        {
            isStreaming = false;
            streamBuffer = "";
            messages.Add(new ChatMessage { Text = $"⚠️ Error: {error}", IsUser = false });
            StateHasChanged();
        });

        await Task.CompletedTask;
        //await hubConnection.StartAsync();
    }

    private async Task SendPrompt()
    {
        if (string.IsNullOrWhiteSpace(userPrompt)) return;

        if (hubConnection is null || hubConnection.State != HubConnectionState.Connected)
        {
            messages.Add(new ChatMessage { Text = "⚠️ Connection not established.", IsUser = false });
            return;
        }

        messages.Add(new ChatMessage { Text = userPrompt, IsUser = true });
        streamBuffer = "";
        isStreaming = true;

        await hubConnection.SendAsync("GeneratePrompt", selectedModel, userPrompt);
        userPrompt = "";
    }

    private class ChatMessage
    {
        public string Text { get; set; } = "";
        public bool IsUser { get; set; }
    }
}