@page "/ollama"
@using Microsoft.AspNetCore.SignalR.Client
@inject NavigationManager Navigation

<h3>Ollama Chat</h3>

<input @bind="userPrompt" placeholder="Enter prompt..." />
<select @bind="selectedModel">
    <option value="phi-2">Phi-2</option>
    <option value="deepseek">DeepSeek</option>
</select>
<button @onclick="SendPrompt">Send</button>

<p><strong>Response:</strong> @response</p>

@code {
    private HubConnection? hubConnection;
    private string userPrompt = "";
    private string selectedModel = "deepseek";
    private string response = "";

    protected override async Task OnInitializedAsync()
    {
        hubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/ollamaHub"))
            .Build();

        hubConnection.On<string>("ReceiveResponse", msg =>
        {
            response = msg;
            StateHasChanged();
        });

        await hubConnection.StartAsync();
    }

    private async Task SendPrompt()
    {
        if (hubConnection is not null)
        {
            await hubConnection.SendAsync("GeneratePrompt", selectedModel, userPrompt);
        }
    }
}