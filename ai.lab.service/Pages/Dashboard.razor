@page "/dashboard"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using ai.lab.service.Services.Auth
@using ai.lab.service.Services.Common
@using ai.lab.service.Model.Outbound
@using ai.lab.service.Model.Inbound
@using System.Security.Claims

@inject JwtAuthStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject IChatService ChatService
@inject AuthenticationStateProvider AuthProvider

@attribute [Authorize]

<div class="page-header" style="margin-bottom:var(--space-6);">
    <h1 class="page-title" style="font-size:var(--font-size-display); margin:0; background:var(--gradient-accent); -webkit-background-clip:text; background-clip:text; color:transparent;">Dashboard</h1>
    <p class="page-subtitle" style="margin:8px 0 0; color:var(--color-text-muted);">Explore active rooms and AI activity.</p>
    <div style="margin-top:var(--space-5); display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:var(--space-4);">
        <div class="card" style="position:relative;">
            <div class="card-content" style="display:flex; flex-direction:column; gap:4px;">
                <span style="font-size:var(--font-size-xs); text-transform:uppercase; letter-spacing:.5px; color:var(--color-text-faint);">Rooms</span>
                <strong style="font-size:var(--font-size-xl);">@(Rooms?.Count ?? 0)</strong>
                <span class="badge badge-accent" style="width:fit-content;">Active</span>
            </div>
        </div>
        <div class="card" style="position:relative;">
            <div class="card-content" style="display:flex; flex-direction:column; gap:4px;">
                <span style="font-size:var(--font-size-xs); text-transform:uppercase; letter-spacing:.5px; color:var(--color-text-faint);">Messages</span>
                <strong style="font-size:var(--font-size-xl);">@(Rooms?.Sum(r => r.TotalMessageCount) ?? 0)</strong>
                <span class="badge" style="width:fit-content;">Cumulative</span>
            </div>
        </div>
        <div class="card" style="position:relative;">
            <div class="card-content" style="display:flex; flex-direction:column; gap:4px;">
                <span style="font-size:var(--font-size-xs); text-transform:uppercase; letter-spacing:.5px; color:var(--color-text-faint);">Unread</span>
                <strong style="font-size:var(--font-size-xl);">@(Rooms?.Sum(r => r.UnreadMessageCount) ?? 0)</strong>
                <span class="badge badge-danger" style="width:fit-content;">Needs attention</span>
            </div>
        </div>
    </div>
</div>

<AuthorizeView>
    <Authorized>
        <div class="card card-inline" style="margin-bottom:var(--space-4);">
            <div class="card-content" style="display:flex; justify-content:space-between; align-items:center; gap:var(--space-4);">
                <span>Hello, <strong>@UserDisplayName</strong></span>
                <button class="btn btn-danger-outline" @onclick="HandleLogoutAsync">Logout</button>
            </div>
        </div>
    </Authorized>
</AuthorizeView>

<section class="section-block" style="margin-top:var(--space-6);">
    <div class="section-header" style="display:flex; justify-content:space-between; align-items:center; gap:var(--space-4);">
        <h2 class="section-title" style="margin:0; font-size:var(--font-size-lg);">Chat Rooms</h2>
        <div style="display:flex; gap:var(--space-3);">
            <button class="btn btn-primary" @onclick="ToggleCreateRoom" disabled="@IsSubmittingRoom">@(ShowCreateRoom ? "Close" : "Create Room")</button>
            <button class="btn btn-secondary" @onclick="LoadRoomsAsync" disabled="@IsLoadingRooms">Refresh</button>
        </div>
    </div>
    @if (ShowCreateRoom)
    {
        <div class="card" style="margin-top:var(--space-4);">
            <div class="card-header"><h3 style="margin:0; font-size:var(--font-size-lg);">New Room</h3></div>
            <div class="card-content form-grid">
            @if (!string.IsNullOrWhiteSpace(CreateError))
            {
                <p class="text-danger" style="margin:0 0 var(--space-2);">@CreateError</p>
            }
                <div class="form-field">
                    <label class="form-label">Title</label>
                    <input class="input" @bind="NewRoomTitle" placeholder="Room title" />
                </div>
                <div class="form-field">
                    <label class="form-label">AI Model (optional)</label>
                    <div>
                        @if (IsLoadingModels)
                        {
                            <span class="text-muted">Loading models...</span>
                        }
                        else if (!string.IsNullOrWhiteSpace(ModelsError))
                        {
                            <span class="text-danger">@ModelsError</span>
                        }
                        else if (AvailableModels?.Count > 0)
                        {
                            <select class="select" @bind="NewRoomAiModel">
                                <option value="">-- No AI (optional) --</option>
                                @foreach (var model in AvailableModels)
                                {
                                    <option value="@model">@model</option>
                                }
                            </select>
                        }
                        else
                        {
                            <span class="text-muted">No models found.</span>
                        }
                    </div>
                </div>
                <div class="form-field">
                    <label class="form-label">Max Participants (2-30)</label>
                    <input class="input" type="number" @bind="NewRoomMaxParticipants" min="2" max="30" />
                </div>
                <div class="form-actions" style="display:flex; gap:var(--space-3); margin-top:var(--space-5);">
                    <button class="btn btn-success" @onclick="CreateRoomAsync" disabled="@IsSubmittingRoom">@(IsSubmittingRoom ? "Creating..." : "Submit")</button>
                    <button class="btn btn-secondary" @onclick="ToggleCreateRoom" disabled="@IsSubmittingRoom">Cancel</button>
                </div>
            </div>
        </div>
    }

    <div style="margin-top:var(--space-5);">
        @if (IsLoadingRooms)
        {
            <p class="text-muted">Loading rooms...</p>
        }
        else if (!string.IsNullOrWhiteSpace(RoomsError))
        {
            <p class="text-danger">@RoomsError</p>
        }
        else if (Rooms == null || Rooms.Count == 0)
        {
            <p class="text-muted">No rooms available.</p>
        }
        else
        {
            <div class="layout-grid" style="--grid-min:240px;">
                @foreach (var room in Rooms)
                {
                    var status = room.IsActive ? (room.IsFull ? "Full" : "Open") : "Inactive";
                    var unread = room.UnreadMessageCount;
                    <div class="card room-card">
                        <div class="card-header" style="display:flex; justify-content:space-between; align-items:center; gap:var(--space-2);">
                            <h3 style="margin:0; font-size:var(--font-size-md);">@room.Title</h3>
                            @if (unread > 0)
                            {
                                <span class="badge badge-accent" title="Unread messages">@unread</span>
                            }
                        </div>
                        <div class="card-content" style="display:flex; flex-direction:column; gap:var(--space-2);">
                            <div class="meta-row" style="display:flex; flex-wrap:wrap; gap:var(--space-3); font-size:var(--font-size-sm); color:var(--color-text-muted);">
                                <span><strong>@room.CurrentParticipantCount</strong>/<strong>@room.MaxParticipants</strong> participants</span>
                                <span><strong>@room.TotalMessageCount</strong> msgs</span>
                                @if (!string.IsNullOrWhiteSpace(room.AiModel))
                                {
                                    <span>Model: <code style="font-size:var(--font-size-xs);">@room.AiModel</code></span>
                                }
                            </div>
                            <div style="font-size:var(--font-size-xs); color:var(--color-text-muted);">Created @room.CreatedAt.ToString("yyyy-MM-dd HH:mm") • @status</div>
                            <div style="display:flex; gap:var(--space-2);">
                                @if (room.IsFull && !room.IsUserInRoom)
                                {
                                    <button class="btn btn-secondary" disabled>Full</button>
                                }
                                else
                                {
                                    <button class="btn btn-primary" @onclick="() => HandleEnterRoomAsync(room)" disabled="@JoiningRoomIds.Contains(room.Id)">@(room.IsUserInRoom ? "Open" : (JoiningRoomIds.Contains(room.Id) ? "Joining..." : "Join"))</button>
                                }
                                <button class="btn btn-danger" @onclick="() => HandleDeleteRoomAsync(room)" disabled="@DeletingRoomIds.Contains(room.Id) || !room.IsActive" title="Delete room">@(DeletingRoomIds.Contains(room.Id) ? "Deleting..." : "Delete")</button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private List<ChatRoomResponse>? Rooms;
    private bool IsLoadingRooms = true;
    private string? RoomsError;
    private string? UserEmail;
    private string? UserDisplayName;
    private bool IsAdmin; // Retained for future use (currently not gating delete)

    // Create room state
    private bool ShowCreateRoom = false;
    private bool IsSubmittingRoom = false;
    private string NewRoomTitle = string.Empty;
    private string? NewRoomAiModel;
    private int? NewRoomMaxParticipants;
    private string? CreateError;
    // AI models state
    private List<string>? AvailableModels;
    private bool IsLoadingModels = false;
    private string? ModelsError;

    private HashSet<long> JoiningRoomIds = new();
    private HashSet<long> DeletingRoomIds = new(); // Track rooms being deleted

    protected override async Task OnInitializedAsync()
    {
        // Ensure auth state is loaded first
        var state = await AuthProvider.GetAuthenticationStateAsync();
        if (!state.User.Identity?.IsAuthenticated ?? true)
        {
            // If not authenticated, redirect to login
            Nav.NavigateTo("/", forceLoad: true);
            return;
        }
        
        await LoadUserAsync();
        await LoadRoomsAsync();
        await LoadModelsAsync();
    }
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Ensure authentication state is fully loaded after first render
            var state = await AuthProvider.GetAuthenticationStateAsync();
            if (!state.User.Identity?.IsAuthenticated ?? true)
            {
                Nav.NavigateTo("/", forceLoad: true);
            }
            else if (string.IsNullOrWhiteSpace(UserEmail))
            {
                // Retry loading user if it failed initially
                await LoadUserAsync();
                StateHasChanged();
            }
        }
    }

    private async Task LoadUserAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        var user = state.User;
        // Attempt multiple possible claim keys for email.
        UserEmail = user.FindFirstValue(ClaimTypes.Email)
                ?? user.FindFirstValue(System.IdentityModel.Tokens.Jwt.JwtRegisteredClaimNames.Email);
        UserDisplayName = user.Identity?.Name ?? UserEmail ?? "Unknown";
        // Detect admin via claim (support both "is_admin" and legacy "isAdmin")
        var adminClaim = user.Claims.FirstOrDefault(c => c.Type == "is_admin")?.Value
            ?? user.Claims.FirstOrDefault(c => c.Type == "isAdmin")?.Value;
        if (!string.IsNullOrWhiteSpace(adminClaim))
        {
            IsAdmin = adminClaim.Equals("true", StringComparison.OrdinalIgnoreCase) || adminClaim.Equals("True", StringComparison.OrdinalIgnoreCase) || adminClaim == "1";
        }
    }

    private async Task LoadRoomsAsync()
    {
        RoomsError = null;
        IsLoadingRooms = true;
        try
        {
            if (string.IsNullOrWhiteSpace(UserEmail))
            {
                RoomsError = "User email missing.";
                return;
            }
            Rooms = await ChatService.GetAllActiveChatRoomsAsync(UserEmail);
        }
        catch (Exception ex)
        {
            RoomsError = $"Failed to load rooms: {ex.Message}";
        }
        finally
        {
            IsLoadingRooms = false;
            StateHasChanged();
        }
    }

    private void ToggleCreateRoom()
    {
        ShowCreateRoom = !ShowCreateRoom;
        if (!ShowCreateRoom)
        {
            // reset form
            NewRoomTitle = string.Empty;
            NewRoomAiModel = null;
            NewRoomMaxParticipants = null;
            CreateError = null;
        }
    }

    private async Task CreateRoomAsync()
    {
        if (IsSubmittingRoom) return;
        CreateError = null;
        if (string.IsNullOrWhiteSpace(UserEmail))
        {
            CreateError = "User not authenticated.";
            return;
        }
        if (string.IsNullOrWhiteSpace(NewRoomTitle) || NewRoomTitle.Length < 3)
        {
            CreateError = "Title must be at least 3 characters.";
            return;
        }
        if (NewRoomMaxParticipants.HasValue && (NewRoomMaxParticipants < 2 || NewRoomMaxParticipants > 30))
        {
            CreateError = "Max participants must be between 2 and 30.";
            return;
        }
        try
        {
            IsSubmittingRoom = true;
            // Convert empty string to null for optional AI model
            var aiModel = string.IsNullOrWhiteSpace(NewRoomAiModel) ? null : NewRoomAiModel;
            var created = await ChatService.CreateChatRoomAsync(UserEmail!, NewRoomTitle, aiModel, NewRoomMaxParticipants);
            // Refresh list
            await LoadRoomsAsync();
            ShowCreateRoom = false;
        }
        catch (Exception ex)
        {
            CreateError = $"Failed to create room: {ex.Message}";
        }
        finally
        {
            IsSubmittingRoom = false;
        }
    }

    private async Task LoadModelsAsync()
    {
        ModelsError = null;
        IsLoadingModels = true;
        try
        {
            AvailableModels = await ChatService.GetAvailableAiModels();
        }
        catch (Exception ex)
        {
            ModelsError = $"Failed to load models: {ex.Message}";
        }
        finally
        {
            IsLoadingModels = false;
            StateHasChanged();
        }
    }



    private async Task HandleEnterRoomAsync(ChatRoomResponse room)
    {
        if (string.IsNullOrWhiteSpace(UserEmail)) return;
        
        // Don't pre-join here - let the Chat page handle joining via SignalR
        // This prevents duplicate participants with different connection IDs
        // Just navigate directly to the chat page
        Nav.NavigateTo($"/chat/{room.Id}");
    }

    private async Task HandleLogoutAsync()
    {
        await AuthStateProvider.LogoutAsync();
        Nav.NavigateTo("/", forceLoad: true);
    }

    private async Task HandleDeleteRoomAsync(ChatRoomResponse room)
    {
    if (string.IsNullOrWhiteSpace(UserEmail)) return; // Only require authenticated user now
        if (DeletingRoomIds.Contains(room.Id)) return;
        try
        {
            DeletingRoomIds.Add(room.Id);
            var success = await ChatService.DeleteChatRoomAsync(room.Id, UserEmail!, CancellationToken.None);
            if (!success)
            {
                RoomsError = "Failed to delete room (not authorized or already inactive).";
            }
            else
            {
                await LoadRoomsAsync();
            }
        }
        catch (Exception ex)
        {
            RoomsError = $"Delete failed: {ex.Message}";
        }
        finally
        {
            DeletingRoomIds.Remove(room.Id);
            StateHasChanged();
        }
    }
}