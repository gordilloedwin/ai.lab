@inject NavigationManager Nav
@code {
    private bool Show => !Nav.Uri.EndsWith("/login", StringComparison.OrdinalIgnoreCase);
}
@if (Show)
{
    <div id="blazor-error-ui">
        An unhandled error has occurred.
        <a href="" class="reload">Reload</a>
        <a class="dismiss">🗙</a>
    </div>
}