@using Microsoft.AspNetCore.Components.Authorization
@using ai.lab.service.Services.Auth
@inject JwtAuthStateProvider AuthStateProvider
@inject NavigationManager Nav

@inherits LayoutComponentBase

<a href="#mainContent" class="skip-link" style="position:absolute;left:-999px;top:-999px;background:var(--color-primary);color:#fff;padding:8px 12px;border-radius:4px;z-index:var(--z-overlay);" onfocus="this.style.left='8px';this.style.top='8px'" onblur="this.style.left='-999px';this.style.top='-999px'">Skip to content</a>
<div class="app-shell" role="application">
    <aside class="sidebar glass" role="navigation" aria-label="Primary">
        <div class="sidebar-brand">AI LAB</div>
        <div class="sidebar-section">
            <AuthorizeView>
                <Authorized>
                    <div class="user-block" style="font-size:var(--font-size-xs); color:var(--color-text-muted); margin-bottom:var(--space-2);">
                        <span>Signed in</span>
                        <div style="font-size:var(--font-size-sm); color:var(--color-text); font-weight:600;">@context.User.Identity?.Name</div>
                    </div>
                    <nav class="sidebar-nav">
                        <a href="/dashboard">Dashboard</a>
                    </nav>
                    <div style="margin-top:auto;">
                        <button class="btn btn-outline" @onclick="HandleLogoutAsync">Logout</button>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <nav class="sidebar-nav">
                        <a href="/">Login</a>
                    </nav>
                </NotAuthorized>
            </AuthorizeView>
        </div>
        <div style="margin-top:auto; font-size:10px; opacity:.55;">&copy; 2025 AI Lab</div>
    </aside>
    <div class="content-area" id="mainContent" role="main" tabindex="-1">
        <div class="content-frame" aria-live="polite">
            @Body
        </div>
    </div>
</div>

@code {
    private async Task HandleLogoutAsync()
    {
        await AuthStateProvider.LogoutAsync();
        Nav.NavigateTo("/", forceLoad: true);
    }
}