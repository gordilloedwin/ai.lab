@using Microsoft.AspNetCore.Components.Authorization
@using ai.lab.service.Services.Auth
@inject JwtAuthStateProvider AuthStateProvider
@inject NavigationManager Nav
@inherits LayoutComponentBase

<header>
    <h2>AI Lab</h2>
    <nav>
        <AuthorizeView>
            <Authorized>
                <span>Welcome, @context.User.Identity?.Name</span> |
                <a href="/dashboard">Dashboard</a> |
                <button @onclick="HandleLogoutAsync" style="border: none; background: none; color: blue; text-decoration: underline; cursor: pointer;">Logout</button>
            </Authorized>
            <NotAuthorized>
                <a href="/">Login</a>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</header>

<main>
    @Body
</main>

<footer>
    <small>&copy; 2025 AI Lab</small>
</footer>

@code {
    private async Task HandleLogoutAsync()
    {
        await AuthStateProvider.LogoutAsync();
        Nav.NavigateTo("/", forceLoad: true);
    }
}