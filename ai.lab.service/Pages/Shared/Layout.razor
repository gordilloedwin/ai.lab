@using Microsoft.AspNetCore.Components.Authorization
@using ai.lab.service.Services.Auth
@inject JwtAuthStateProvider AuthStateProvider
@inject NavigationManager Nav

@inherits LayoutComponentBase

<div class="app-shell">
    <aside class="sidebar glass">
        <div class="sidebar-brand">AI LAB</div>
        <div class="sidebar-section">
            <AuthorizeView>
                <Authorized>
                    <div class="user-block" style="font-size:var(--font-size-xs); color:var(--color-text-muted); margin-bottom:var(--space-2);">
                        <span>Signed in</span>
                        <div style="font-size:var(--font-size-sm); color:var(--color-text); font-weight:600;">@context.User.Identity?.Name</div>
                    </div>
                    <nav class="sidebar-nav">
                        <a href="/dashboard">Dashboard</a>
                        <a href="/">Login</a>
                    </nav>
                    <div style="margin-top:auto;">
                        <button class="btn btn-outline" @onclick="HandleLogoutAsync">Logout</button>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <nav class="sidebar-nav">
                        <a href="/">Login</a>
                    </nav>
                </NotAuthorized>
            </AuthorizeView>
        </div>
        <div style="margin-top:auto; font-size:10px; opacity:.55;">&copy; 2025 AI Lab</div>
    </aside>
    <div class="content-area">
        <div class="content-frame">
            @Body
        </div>
    </div>
</div>

@code {
    private async Task HandleLogoutAsync()
    {
        await AuthStateProvider.LogoutAsync();
        Nav.NavigateTo("/", forceLoad: true);
    }
}