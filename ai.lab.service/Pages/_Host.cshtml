@page "/_Host"
@namespace ai.lab.service.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.Razor
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AI Lab</title>
    <base href="/" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="/css/core.css" rel="stylesheet" />
    <link href="/css/auth.css" rel="stylesheet" />
    <link href="/css/highlight-theme.min.css" rel="stylesheet" />
    <link href="/css/markdown.css" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg" />
</head>
<body>
    <component type="typeof(App)" render-mode="Server" />

    <component type="typeof(ai.lab.service.Pages.Shared.ConditionalErrorUi)" render-mode="Server" />

    <script>
        // Remove any stray light theme class
        document.documentElement.classList.remove('theme-light');
    </script>
    <script src="_framework/blazor.server.js"></script>
    <script src="/marked.min.js"></script>
    <script src="/highlight.min.js"></script>
    <script src="/chat-markdown.js"></script>
    <script src="/chat.js"></script>
</body>
</html>