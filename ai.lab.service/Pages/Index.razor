@page "/"
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthProvider

<div class="text-center text-muted" style="padding:2rem;">
    <p>Redirecting...</p>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        // Determine if a user is already authenticated; if so go to dashboard, else login.
        var state = await AuthProvider.GetAuthenticationStateAsync();

        var user = state.User;
        if (user?.Identity is not null && user.Identity.IsAuthenticated)
        {
            Nav.NavigateTo("/dashboard", replace: true);
        }
        else
        {
            try 
            {
                Nav.NavigateTo("/login", replace: true);
            }
            catch (Microsoft.AspNetCore.Components.NavigationException)
            {
                // Expected during prerender – safely ignore.
            }
        }
    }
}
