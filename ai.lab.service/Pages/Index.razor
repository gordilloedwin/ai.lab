@page "/"
@using Microsoft.AspNetCore.Components
@using ai.lab.service.Model
@using ai.lab.service.Services.Common
@using ai.lab.service.Services.Auth
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims

@inject IAuthService AuthService
@inject NavigationManager Nav
@inject JwtAuthStateProvider AuthStateProvider

@attribute [LayoutAttribute(typeof(NoLayout))]

@if (checkingAuth)
{
    <p>Checking session...</p>
}
else if (isAuthenticated)
{
    <p>Redirecting to dashboard...</p>
}
else
{
    <div class="auth-wrapper">
        <div class="auth-card" role="form" aria-labelledby="loginHeading">
            <div class="auth-header">
                <img src="/images/flask-logo.svg" alt="AI Lab Flask" style="width:64px; height:64px; margin:0 auto;" />
                <h1 id="loginHeading" class="brand-title">AI Lab</h1>
                <p class="brand-tagline">Intelligent experimentation platform</p>
            </div>
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="error-banner" role="alert">@errorMessage</div>
            }
            <form @onsubmit="HandleLoginAsync" class="auth-form" style="display:flex; flex-direction:column; gap:var(--space-4);" aria-describedby="loginHelp">
                <div class="form-group">
                    <label for="emailInput">Email</label>
                    <input id="emailInput" type="email" @bind="email" required autocomplete="username" />
                </div>
                <div class="form-group">
                    <label for="passwordInput">Password</label>
                    <input id="passwordInput" type="password" @bind="password" required autocomplete="current-password" />
                </div>
                <div id="loginHelp" style="font-size:var(--font-size-xs); color:var(--color-text-muted);">Use your registered credentials to sign in.</div>
                <div class="actions">
                    <button class="btn-primary-auth" type="submit" disabled="@isLoading">@(isLoading ? "Signing in..." : "Sign In")</button>
                </div>
            </form>
        </div>
    </div>
}

@code {
    private string email = string.Empty;
    private string password = string.Empty;
    private string errorMessage = string.Empty;
    private bool isLoading = false;
    private bool checkingAuth = true;
    private bool isAuthenticated = false;

    protected override async Task OnInitializedAsync()
    {
        // Check existing authentication state; if valid, redirect.
        try
        {
            var state = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = state.User;
            if (user.Identity?.IsAuthenticated == true && !string.IsNullOrWhiteSpace(user.FindFirstValue(ClaimTypes.Email)))
            {
                isAuthenticated = true;
                // Slight delay to allow UI to render message
                _ = Task.Run(async () =>
                {
                    await Task.Delay(100);
                    Nav.NavigateTo("/dashboard", forceLoad: true);
                });
            }
        }
        catch { }
        finally
        {
            checkingAuth = false;
            StateHasChanged();
        }
    }

    private async Task HandleLoginAsync()
    {
        errorMessage = string.Empty;
        isLoading = true;

        try
        {
            var signInRequest = new SignInRequest
            {
                Email = email,
                Password = password
            };

            var result = await AuthService.LoginAsync(signInRequest);

            if (result.Contains('.') && result.Split('.').Length == 3)
            {
                await AuthStateProvider.MarkUserAsAuthenticatedAsync(result);
                
                // Give the auth state a moment to propagate
                await Task.Delay(100);
                
                Nav.NavigateTo("/dashboard");
            }
            else
            {
                errorMessage = result;
            }
        }
        catch (Exception)
        {
            errorMessage = "An error occurred during login. Please try again.";
        }
        finally
        {
            isLoading = false;
        }
    }

    public class NoLayout : LayoutComponentBase
    {
        protected override void BuildRenderTree(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder builder)
        {
            builder.AddContent(0, Body);
        }
    }
}
