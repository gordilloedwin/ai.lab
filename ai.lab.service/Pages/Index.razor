@page "/"
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Nav

<div class="landing-root d-flex flex-column align-items-center justify-content-center" style="min-height:65vh; padding:2rem;">
    <h1 class="display-5 fw-semibold mb-3">AI Lab</h1>
    <p class="text-muted mb-4" style="max-width:600px;">Experimental playground for embeddings, model orchestration and observability. Sign in to access your dashboard.</p>
    <div class="d-flex gap-3">
        <button class="btn btn-primary px-4 py-2" @onclick="GoLogin">Sign In</button>
        <button class="btn btn-outline-secondary px-4 py-2" @onclick="GoDocs">Docs</button>
    </div>
    @if (forwarding)
    {
        <div class="mt-4 text-muted small">Redirecting to your dashboard...</div>
    }
</div>

@code {
    private bool forwarding = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var state = await AuthProvider.GetAuthenticationStateAsync();
            if (state.User?.Identity?.IsAuthenticated == true)
            {
                forwarding = true;
                StateHasChanged();
                // brief UX pause
                await Task.Delay(200);
                Nav.NavigateTo("/dashboard", replace: true);
            }
        }
        catch { /* ignore */ }
    }

    private void GoLogin() => Nav.NavigateTo("/login");
    private void GoDocs() => Nav.NavigateTo("/documentation", forceLoad: true);
}
