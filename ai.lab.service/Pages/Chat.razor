@page "/chat/{RoomId:long}"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.SignalR.Client
@using ai.lab.service.Model.Outbound
@using System.Security.Claims
@using Microsoft.JSInterop

@attribute [Authorize]

@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthProvider
@inject ai.lab.service.Services.Auth.JwtAuthStateProvider JwtProvider
@inject IJSRuntime Js


<div class="page-header" style="margin-bottom:var(--space-5);">
    <h2 class="page-title" style="margin:0; font-size:var(--font-size-xl); font-weight:600; letter-spacing:.5px;">Chat Room @RoomId</h2>
    <p class="text-muted" style="margin-top:4px; font-size:var(--font-size-sm);">Real-time collaboration & AI responses.</p>
</div>

@if (InitError != null)
{
    <p style="color:red">@InitError</p>
}
else if (!Connected)
{
    <p>Connecting to chat...</p>
}
else
{
    <div class="chat-layout" style="display:flex; gap:var(--space-5); align-items:stretch;" role="main" aria-label="Chat conversation area">
        <div id="chatMessages" class="card" style="flex:1; max-height:65vh; overflow:auto; scroll-behavior:smooth;">
            <div class="card-header" style="position:sticky; top:0; background:var(--color-surface); z-index:2;">
                <h3 style="margin:0; font-size:var(--font-size-md);">Messages</h3>
                @if (AiStreaming)
                {
                    <div class="typing-indicator" aria-live="polite" style="font-size:var(--font-size-xs); color:var(--color-text-muted); display:flex; align-items:center; gap:4px;">
                        <span>AI typing</span>
                        <span class="dots" style="display:inline-flex; gap:2px;">
                            <span class="dot" style="width:6px; height:6px; background:var(--color-primary); border-radius:50%; animation:blink 1s infinite .0s;"></span>
                            <span class="dot" style="width:6px; height:6px; background:var(--color-primary); border-radius:50%; animation:blink 1s infinite .2s;"></span>
                            <span class="dot" style="width:6px; height:6px; background:var(--color-primary); border-radius:50%; animation:blink 1s infinite .4s;"></span>
                        </span>
                    </div>
                }
            </div>
            <div class="card-content messages" style="display:flex; flex-direction:column; gap:var(--space-3);">
                @if (Messages.Count == 0)
                {
                    <p class="text-muted" style="margin:0;">No messages yet.</p>
                }
                else
                {
                    foreach (var m in Messages)
                    {
                        var readByCount = Participants.Count(p => p.LastReadMessageId.HasValue && p.LastReadMessageId.Value >= m.Id);
                        var isAi = m.SenderType == "ai";
                        <div class="message @(isAi ? "message-ai" : "message-user")" data-message-id="@m.Id" @onmouseenter="() => HoverMessageId = m.Id" @onmouseleave="() => HoverMessageId = null" style="position:relative;">
                            <div class="message-meta">
                                <span class="message-sender">@(isAi ? "AI" : m.SenderName ?? m.SenderEmail)</span>
                                <span class="message-time">@m.CreatedAt.ToString("HH:mm:ss")</span>
                                @if (readByCount > 0)
                                {
                                    <span class="message-read" title="Read by participants">Read @readByCount</span>
                                }
                            </div>
                            <div class="message-content">
                                @if (EditingMessageId == m.Id)
                                {
                                    <textarea class="input" style="min-height:80px;" @bind="EditBuffer"></textarea>
                                    <div style="display:flex; gap:var(--space-2); margin-top:4px;">
                                        <button class="btn btn-success btn-xs" @onclick="() => SaveEditAsync(m)">Save</button>
                                        <button class="btn btn-secondary btn-xs" @onclick="CancelEdit">Cancel</button>
                                    </div>
                                }
                                else
                                {
                                    @m.Content
                                }
                            </div>
                            @if (m.SenderType == "user" && m.IsOwnMessage && HoverMessageId == m.Id && EditingMessageId != m.Id)
                            {
                                <div class="message-actions" style="position:absolute; top:4px; right:4px; display:flex; gap:4px;">
                                    <button class="btn btn-secondary btn-xs" title="Edit" @onclick="() => BeginEdit(m)">Edit</button>
                                    <button class="btn btn-danger btn-xs" title="Delete" @onclick="() => DeleteMessageAsync(m)">Del</button>
                                </div>
                            }
                        </div>
                    }
                    @if (AiStreaming && !string.IsNullOrWhiteSpace(AiStreamBuffer))
                    {
                        <div class="message message-ai" style="opacity:.85;">
                            <div class="message-meta">
                                <span class="message-sender">AI</span>
                                <span class="message-time">Streaming...</span>
                            </div>
                            <div class="message-content" aria-live="polite">@AiStreamBuffer</div>
                        </div>
                    }
                }
            </div>
        </div>
        <div class="card" style="width:300px; max-height:65vh; overflow:auto;" role="complementary" aria-label="Participants list">
            <div class="card-header" style="position:sticky; top:0; background:var(--color-surface); z-index:2;">
                <h3 style="margin:0; font-size:var(--font-size-md);">Participants</h3>
            </div>
            <div class="card-content" style="display:flex; flex-direction:column; gap:var(--space-2);">
                @if (Participants.Count == 0)
                {
                    <p class="text-muted" style="margin:0;">None</p>
                }
                else
                {
                    foreach (var p in Participants)
                    {
                        <div class="participant-row" style="display:flex; justify-content:space-between; align-items:center; font-size:var(--font-size-sm);">
                            <span>@(p.UserName ?? p.UserEmail)</span>
                            @if (p.IsCurrentlyConnected)
                            {
                                <span class="badge badge-success" style="font-size:var(--font-size-xs);">online</span>
                            }
                            else
                            {
                                <span class="badge" style="font-size:var(--font-size-xs); opacity:.7;">offline</span>
                            }
                        </div>
                    }
                }
                <div style="margin-top:var(--space-3);">
                    <button class="btn btn-danger-outline" @onclick="LeaveRoomAsync">Leave Room</button>
                </div>
            </div>
        </div>
    </div>

    <div class="composer" style="margin-top:var(--space-5);" aria-label="Message composer" role="form">
        <div style="display:flex; flex-direction:column; gap:var(--space-3);">
            <textarea class="input" style="min-height:110px; resize:vertical;" @bind="OutgoingText" placeholder="Type message or AI prompt..." @onkeydown="HandleComposerKey"></textarea>
            <div style="display:flex; gap:var(--space-3); flex-wrap:wrap; align-items:center;">
                @* Status / notice for AI busy or rejection *@
                @if (RoomAiBusy)
                {
                    <span class="badge" style="background:var(--color-warning); color:#000;">AI busy...</span>
                }
                else if (!string.IsNullOrWhiteSpace(AiBusyMessage))
                {
                    <span class="badge" style="background:var(--color-danger);">@AiBusyMessage</span>
                }
                <button class="btn btn-primary" @onclick="SendMessageAsync" disabled="@Sending">@(Sending ? "Sending..." : "Send to Group")</button>
                <button class="btn btn-secondary" @onclick="SendAiAsync" disabled="@(SendingAi || RoomAiBusy)">@(SendingAi ? "Thinking..." : RoomAiBusy ? "AI Busy" : "Ask AI (legacy)")</button>
                <button class="btn btn-secondary-outline" @onclick="SendAiStreamAsync" disabled="@(SendingAi || RoomAiBusy)">@(SendingAi ? "Thinking..." : RoomAiBusy ? "AI Busy" : "Stream AI")</button>
                <label style="display:flex; align-items:center; gap:var(--space-1); font-size:var(--font-size-sm); cursor:pointer;">
                    <input type="checkbox" @bind="UseRag" /> Use RAG
                </label>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public long RoomId { get; set; }

    private HubConnection? hub;
    private bool Connected = false;
    private string? InitError;
    private List<ChatMessageResponse> Messages = new();
    private List<ChatParticipantResponse> Participants = new();
    private ChatRoomResponse? Room;
    private string OutgoingText = string.Empty;
    private bool Sending = false;
    private bool SendingAi = false;
    private bool UseRag = false;
    private string? UserEmail;
    private bool AiStreaming = false;
    private string AiStreamBuffer = string.Empty;
    private string? CurrentStreamId;
    private long? HoverMessageId;
    private long? EditingMessageId;
    private string EditBuffer = string.Empty;
    private bool RoomAiBusy = false;
    private string? AiBusyMessage;
    // Debounce state for read marking
    private DateTime _lastReadMarkUtc = DateTime.MinValue;
    private static readonly TimeSpan ReadDebounce = TimeSpan.FromSeconds(2);
    // Auto-scroll trigger flag
    private bool _shouldScrollAfterRender = false;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        var user = state.User;
        UserEmail = user.FindFirstValue(ClaimTypes.Email)
                    ?? user.FindFirstValue(System.IdentityModel.Tokens.Jwt.JwtRegisteredClaimNames.Email)
                    ?? user.FindFirstValue("email");
        await SetupHubAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Initialize JS scroll module on first render
            try 
            { 
                await Js.InvokeVoidAsync("AILabChat.init", "chatMessages"); 
            } 
            catch 
            { 
                // Silently ignore if module not loaded yet
            }
        }
        
        // Trigger auto-scroll after render if flag is set
        if (_shouldScrollAfterRender)
        {
            _shouldScrollAfterRender = false;
            try
            {
                await Js.InvokeVoidAsync("AILabChat.notifyNewMessage");
            }
            catch
            {
                // Silently handle JS interop errors (e.g., disconnect during render)
            }
        }
    }

    private async Task SetupHubAsync()
    {
        try
        {
            var accessToken = await GetTokenAsync();
            hub = new HubConnectionBuilder()
                .WithUrl(Nav.ToAbsoluteUri("/ailabchat"), options =>
                {
                    options.AccessTokenProvider = () => Task.FromResult(accessToken);
                })
                .WithAutomaticReconnect()
                .Build();

            RegisterHandlers();
            await hub.StartAsync();
            Connected = true;
            await InitRoomAsync();
        }
        catch (Exception ex)
        {
            InitError = $"Failed to connect: {ex.Message}";
        }
    }

    private void RegisterHandlers()
    {
        if (hub == null) return;

        hub.On<string>("ParticipantJoined", email =>
        {
            var existing = Participants.FirstOrDefault(p => p.UserEmail == email);
            if (existing != null)
            {
                existing.IsCurrentlyConnected = true;
            }
            else
            {
                Participants.Add(new ChatParticipantResponse
                {
                    UserEmail = email,
                    UserName = email,
                    IsCurrentlyConnected = true,
                    JoinedAt = DateTime.UtcNow
                });
            }
            InvokeAsync(StateHasChanged);
        });

        hub.On<string>("ParticipantLeft", email =>
        {
            var existing = Participants.FirstOrDefault(p => p.UserEmail == email);
            if (existing != null)
            {
                existing.LeftAt = DateTime.UtcNow;
                existing.IsCurrentlyConnected = false;
            }
            InvokeAsync(StateHasChanged);
        });

        hub.On<string>("ParticipantDisconnected", email =>
        {
            var existing = Participants.FirstOrDefault(p => p.UserEmail == email);
            if (existing != null)
            {
                existing.IsCurrentlyConnected = false;
            }
            InvokeAsync(StateHasChanged);
        });

        hub.On<ChatMessageResponse>("ReceiveMessage", message =>
        {
            Messages.Add(message);
            _shouldScrollAfterRender = true;
            InvokeAsync(StateHasChanged);
        });

        hub.On<long, string>("AiTypingStarted", (roomId, streamId) =>
        {
            if (roomId != RoomId) return;
            AiStreaming = true;
            AiStreamBuffer = string.Empty;
            CurrentStreamId = streamId;
            InvokeAsync(StateHasChanged);
        });

        hub.On<long, string, string>("AiTypingChunk", (roomId, streamId, chunk) =>
        {
            if (roomId != RoomId || streamId != CurrentStreamId) return;
            AiStreamBuffer += chunk;
            _shouldScrollAfterRender = true;
            InvokeAsync(StateHasChanged);
        });

        hub.On<long, string, ChatMessageResponse>("AiTypingCompleted", (roomId, streamId, finalMessage) =>
        {
            if (roomId != RoomId || streamId != CurrentStreamId) return;
            AiStreaming = false;
            AiStreamBuffer = string.Empty;
            CurrentStreamId = null;
            Messages.Add(finalMessage);
            _shouldScrollAfterRender = true;
            InvokeAsync(StateHasChanged);
        });

        hub.On<long, string, string>("AiTypingError", (roomId, streamId, error) =>
        {
            if (roomId != RoomId || streamId != CurrentStreamId) return;
            AiStreaming = false;
            AiStreamBuffer = $"[[Error: {error}]]";
            CurrentStreamId = null;
            InvokeAsync(StateHasChanged);
        });

        hub.On<ChatMessageResponse>("MessageUpdated", updated =>
        {
            var existing = Messages.FirstOrDefault(m => m.Id == updated.Id);
            if (existing != null)
            {
                existing.Content = updated.Content;
            }
            InvokeAsync(StateHasChanged);
        });

        hub.On<ChatMessageResponse>("MessageDeleted", deleted =>
        {
            var existing = Messages.FirstOrDefault(m => m.Id == deleted.Id);
            if (existing != null)
            {
                existing.Content = deleted.Content;
            }
            InvokeAsync(StateHasChanged);
        });

        hub.On<long, string, long>("ReadReceiptUpdated", (roomId, email, lastReadId) =>
        {
            if (roomId != RoomId) return;
            var participant = Participants.FirstOrDefault(p => p.UserEmail == email);
            if (participant != null)
            {
                participant.LastReadMessageId = lastReadId;
            }
            InvokeAsync(StateHasChanged);
        });

        // AI busy state broadcast (per-room lock)
        hub.On<long, bool>("AiBusyStateChanged", (roomId, isBusy) =>
        {
            if (roomId != RoomId) return;
            RoomAiBusy = isBusy;
            if (!isBusy)
            {
                // Clear transient message after unlock
                AiBusyMessage = null;
            }
            InvokeAsync(StateHasChanged);
        });

        // Rejection when attempting to ask while busy
        hub.On<long, string>("AiBusyRejected", (roomId, reason) =>
        {
            if (roomId != RoomId) return;
            AiBusyMessage = reason;
            InvokeAsync(StateHasChanged);
            // Auto-clear after short delay
            _ = Task.Run(async () =>
            {
                await Task.Delay(4000);
                AiBusyMessage = null;
                await InvokeAsync(StateHasChanged);
            });
        });
    }

    private async Task InitRoomAsync()
    {
        if (hub == null) return;
        try
        {
            var snapshot = await hub.InvokeAsync<ChatRoomInitResponse>("JoinChatRoom", RoomId);
            if (snapshot == null || snapshot.Room == null)
            {
                InitError = "Unable to join room (maybe full or inactive).";
                return;
            }
            Room = snapshot.Room;
            Participants = snapshot.Participants;
            Messages = snapshot.Messages;
        }
        catch (Exception ex)
        {
            InitError = $"Failed to initialize room: {ex.Message}";
        }
    }

    private async Task SendMessageAsync()
    {
        if (hub == null || string.IsNullOrWhiteSpace(OutgoingText)) return;
        try
        {
            Sending = true;
            var text = OutgoingText.Trim();
            OutgoingText = string.Empty;
            await hub.InvokeAsync("SendMessage", RoomId, text);
        }
        catch { }
        finally { Sending = false; }
    }

    private async Task SendAiAsync()
    {
        if (hub == null || string.IsNullOrWhiteSpace(OutgoingText)) return;
        try
        {
            SendingAi = true;
            var text = OutgoingText.Trim();
            OutgoingText = string.Empty;
            await hub.InvokeAsync("AskAi", RoomId, text, UseRag);
        }
        catch { }
        finally { SendingAi = false; }
    }

    private async Task SendAiStreamAsync()
    {
        if (hub == null || string.IsNullOrWhiteSpace(OutgoingText)) return;
        try
        {
            SendingAi = true;
            var text = OutgoingText.Trim();
            OutgoingText = string.Empty;
            await hub.InvokeAsync("AskAiStream", RoomId, text, UseRag);
        }
        catch { }
        finally { SendingAi = false; }
    }

    private async Task LeaveRoomAsync()
    {
        if (hub == null) return;
        try
        {
            await hub.InvokeAsync("LeaveChatRoom", RoomId);
            Nav.NavigateTo("/dashboard");
        }
        catch { }
    }

    private async Task<string?> GetTokenAsync()
    {
        var token = await JwtProvider.GetCurrentTokenAsync();
        return token;
    }

    private async Task MarkLastMessageAsReadAsync()
    {
        if (hub == null || Messages.Count == 0 || string.IsNullOrWhiteSpace(UserEmail)) return;
        // Debounce: only mark if sufficient time elapsed or first time
        if (DateTime.UtcNow - _lastReadMarkUtc < ReadDebounce) return;
        try
        {
            var lastMessageId = Messages.Last().Id;
            await hub.InvokeAsync("MarkRead", RoomId, lastMessageId);
            _lastReadMarkUtc = DateTime.UtcNow;
        }
        catch
        {
            // Silently fail - read receipt is non-critical
        }
    }

    [JSInvokable]
    public async Task OnChatScrolledNearBottom()
    {
        await MarkLastMessageAsReadAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (hub != null)
        {
            try
            {
                await hub.StopAsync();
                await hub.DisposeAsync();
            }
            catch { }
        }
    }

    private void BeginEdit(ChatMessageResponse message)
    {
        EditingMessageId = message.Id;
        EditBuffer = message.Content;
    }

    private void CancelEdit()
    {
        EditingMessageId = null;
        EditBuffer = string.Empty;
    }

    private async Task SaveEditAsync(ChatMessageResponse message)
    {
        if (hub == null || EditingMessageId != message.Id) return;
        var newContent = EditBuffer.Trim();
        if (string.IsNullOrWhiteSpace(newContent)) return; // do not allow blank
        try
        {
            await hub.InvokeAsync("EditMessage", RoomId, message.Id, newContent);
        }
        catch { }
        finally
        {
            EditingMessageId = null;
            EditBuffer = string.Empty;
        }
    }

    private async Task DeleteMessageAsync(ChatMessageResponse message)
    {
        if (hub == null) return;
        try
        {
            await hub.InvokeAsync("DeleteMessage", RoomId, message.Id);
        }
        catch { }
    }

    private void HandleComposerKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            _ = SendMessageAsync();
        }
    }


}
