@page "/"
@using ai.lab.service.Model
@using ai.lab.service.Services.Common
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage

@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject ProtectedLocalStorage LocalStorage
@inject AuthenticationStateProvider AuthProvider

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - AI Lab</title>
    <base href="~/" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="~/bootstrap/bootstrap.min.css" rel="stylesheet" />
    <link href="~/app.css" rel="stylesheet" />
    <link href="~/login.css" rel="stylesheet" />
</head>
<body>
    <!-- Header -->
    <header class="header px-4 py-3 d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center gap-3">
            <img src="~/images/ai-lab-logo.png" class="logo" alt="AI Lab logo" style="height: 40px;" />
            <span class="fw-bold fs-5">AI Lab</span>
        </div>
        <div class="d-flex gap-2">
            <span class="text-muted small">Need help?</span>
            <a href="#" class="text-decoration-none fw-semibold" style="color: #667eea;">Support</a>
        </div>
    </header>

    <!-- Decorative Background Circles -->
    <div class="decorative-circle circle-1"></div>
    <div class="decorative-circle circle-2"></div>

    <!-- Login Container -->
    <div class="login-container">
        <div class="login-card">
            <!-- Login Header -->
            <div class="login-header">
                <img src="~/images/ai-lab-logo.png" class="login-logo" alt="AI Lab" />
                <h1>Welcome Back</h1>
                <p>Sign in to continue to AI Lab</p>
            </div>

            <!-- Alert Messages -->
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger">
                    <span>@errorMessage</span>
                </div>
            }

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert alert-success">
                    <span>@successMessage</span>
                </div>
            }

            <!-- Login Form -->
            <form @onsubmit="HandleLogin" @onsubmit:preventDefault="true" class="login-form">
                <!-- Email Field -->
                <div class="form-group">
                    <label class="form-label">Email Address</label>
                    <div class="input-wrapper">
                        <span class="input-icon">📧</span>
                        <input @bind="signInRequest.Email" 
                               type="email" 
                               class="form-control" 
                               placeholder="you@example.com"
                               autocomplete="email"
                               required />
                    </div>
                </div>

                <!-- Password Field -->
                <div class="form-group">
                    <label class="form-label">Password</label>
                    <div class="input-wrapper">
                        <span class="input-icon">🔒</span>
                        <input @bind="signInRequest.Password" 
                               type="@(showPassword ? "text" : "password")" 
                               class="form-control" 
                               placeholder="Enter your password"
                               autocomplete="current-password"
                               required />
                        <button type="button" 
                                class="password-toggle" 
                                @onclick="TogglePasswordVisibility"
                                aria-label="Toggle password visibility">
                            @(showPassword ? "👁️" : "👁️‍🗨️")
                        </button>
                    </div>
                </div>

                <!-- Form Options -->
                <div class="form-options">
                    <label class="remember-me">
                        <input type="checkbox" @bind="rememberMe" />
                        <span>Remember me</span>
                    </label>
                    <a href="#" class="forgot-password">Forgot password?</a>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="btn-login" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span class="spinner"></span>
                        <span>Signing in...</span>
                    }
                    else
                    {
                        <span>Sign In</span>
                    }
                </button>
            </form>

            <!-- Divider -->
            <div class="divider">
                <span>or continue with</span>
            </div>

            <!-- Social Login -->
            <div class="social-login">
                <button type="button" class="btn-social" @onclick="@(() => HandleSocialLogin("Google"))">
                    <svg viewBox="0 0 24 24" fill="currentColor">
                        <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                        <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                        <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                        <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                    </svg>
                    <span>Google</span>
                </button>
                <button type="button" class="btn-social" @onclick="@(() => HandleSocialLogin("Microsoft"))">
                    <svg viewBox="0 0 24 24" fill="currentColor">
                        <path d="M11.4 24H0V12.6h11.4V24zM24 24H12.6V12.6H24V24zM11.4 11.4H0V0h11.4v11.4zm12.6 0H12.6V0H24v11.4z" fill="#00A4EF"/>
                    </svg>
                    <span>Microsoft</span>
                </button>
            </div>

            <!-- Sign Up Link -->
            <div class="signup-link">
                Don't have an account? <a href="#">Sign up for free</a>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="footer">
        <p class="text-muted">&copy; 2025 AI Lab. All rights reserved.</p>
        <div class="footer-links">
            <a href="#">Privacy Policy</a>
            <a href="#">Terms of Service</a>
            <a href="#">Contact Us</a>
            <a href="#">Documentation</a>
        </div>
    </footer>

    <script src="_framework/blazor.server.js"></script>
</body>
</html>

@code {
    private SignInRequest signInRequest = new SignInRequest { Email = string.Empty, Password = string.Empty };
    private string? errorMessage;
    private string? successMessage;
    private bool isLoading = false;
    private bool showPassword = false;
    private bool rememberMe = false;

    private void TogglePasswordVisibility()
    {
        showPassword = !showPassword;
    }

    private async Task HandleLogin()
    {
        try
        {
            // Clear previous messages
            errorMessage = null;
            successMessage = null;
            isLoading = true;

            var user = await AuthService.SingInUserAsync(signInRequest, CancellationToken.None);
            if (user is not null)
            {
                var token = AuthService.GenerateToken(user);
                await LocalStorage.SetAsync("jwt", token);

                if (AuthProvider is JwtAuthStateProvider jwtProvider)
                {
                    jwtProvider.SetToken(token);
                }

                successMessage = "Login successful! Redirecting...";
                StateHasChanged();
                
                // Small delay to show success message
                await Task.Delay(1000);
                Navigation.NavigateTo("/dashboard");
            }
            else
            {
                errorMessage = "Invalid email or password. Please try again.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "An error occurred during login. Please try again later.";
            // Log the exception if you have a logging service
            Console.WriteLine($"Login error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void HandleSocialLogin(string provider)
    {
        // Placeholder for social login functionality
        errorMessage = $"{provider} login is not yet configured.";
        StateHasChanged();
    }
}