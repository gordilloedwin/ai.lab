@page "/login"
@layout LoginLayout
@rendermode InteractiveServer
@using ai.lab.service.Model
@using ai.lab.service.Services.Common
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage

@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject ProtectedLocalStorage LocalStorage
@inject AuthenticationStateProvider AuthProvider
@inject ILogger<Login> Logger

<div class="theme-root" data-theme="@currentTheme">
    @if (redirecting)
    {
        <div class="redirect-overlay" aria-live="polite">
            <div class="redirect-dialog">
                <div class="redirect-spinner"></div>
                <div class="redirect-text">Taking you to your dashboard...</div>
            </div>
        </div>
    }
    <!-- Header -->
    <header class="header px-4 py-3 d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center gap-3">
            <img src="ai-lab-logo.png" class="logo" alt="AI Lab logo" />
        </div>
        <div class="d-flex align-items-center gap-2">
            <button type="button" class="theme-toggle" @onclick="ToggleTheme" aria-label="Toggle dark mode">
                @if (currentTheme == "dark")
                {
                    <span>🌙</span>
                }
                else
                {
                    <span>☀️</span>
                }
            </button>
        </div>
    </header>

    <!-- Decorative Background Circles -->
    <div class="decorative-circle circle-1"></div>
    <div class="decorative-circle circle-2"></div>

    <!-- Login Container -->
    <div class="login-container">
        <div class="login-card">
            <!-- Login Header -->
            <div class="login-header">
                <img src="ai-lab-logo.png" class="login-logo" alt="AI Lab" />
                <h1>Welcome</h1>
                <p>Sign in to continue to AI Lab</p>
            </div>

            <!-- Alert Messages -->
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger">
                    <span>@errorMessage</span>
                </div>
            }

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert alert-success">
                    <span>@successMessage</span>
                </div>
            }

            <!-- Login Form -->
            <form @onsubmit="HandleLogin" @onsubmit:preventDefault="true" class="login-form">
                <!-- Email Field -->
                <div class="form-group">
                    <label class="form-label">Email Address</label>
                    <div class="input-wrapper">
                        <span class="input-icon">📧</span>
                        <input @bind="signInRequest.Email" 
                               type="email" 
                               class="form-control" 
                               placeholder="you@example.com"
                               autocomplete="email"
                               required />
                    </div>
                </div>

                <!-- Password Field -->
                <div class="form-group">
                    <label class="form-label">Password</label>
                    <div class="input-wrapper">
                        <span class="input-icon">🔒</span>
                        <input @bind="signInRequest.Password" 
                               type="@(showPassword ? "text" : "password")" 
                               class="form-control" 
                               placeholder="Enter your password"
                               autocomplete="current-password"
                               required />
                        <button type="button" 
                                class="password-toggle" 
                                @onclick="TogglePasswordVisibility"
                                aria-label="Toggle password visibility">
                            @(showPassword ? "👁️" : "👁️‍🗨️")
                        </button>
                    </div>
                </div>

                <!-- Form Options -->
                <div class="form-options">
                    <label class="remember-me">
                        <input type="checkbox" @bind="rememberMe" />
                        <span>Remember me</span>
                    </label>
                    <a href="#" class="forgot-password">Forgot password?</a>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="btn-login" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span class="spinner"></span>
                        <span>Signing in...</span>
                    }
                    else
                    {
                        <span>Sign In</span>
                    }
                </button>
            </form>

        </div>
    </div>

    <!-- Footer -->
    <footer class="footer">
        <p class="text-muted">&copy; 2025 AI Lab. All rights reserved.</p>
        <div class="footer-links">
            <a href="#">Privacy Policy</a>
            <a href="#">Terms of Service</a>
            <a href="#">Contact Us</a>
            <a href="#">Documentation</a>
        </div>
    </footer>
</div>

@code {
    private SignInRequest signInRequest = new SignInRequest { Email = string.Empty, Password = string.Empty };
    private string? errorMessage;
    private string? successMessage;
    private bool isLoading = false;
    private bool showPassword = false;
    private bool rememberMe = false;
    private string currentTheme = "light";
    private bool redirecting = false;

    private void TogglePasswordVisibility()
    {
        showPassword = !showPassword;
    }

    protected override async Task OnInitializedAsync()
    {
        // Attempt to restore theme preference
        try
        {
            var stored = await LocalStorage.GetAsync<string>("theme");
            if (stored.Success && !string.IsNullOrWhiteSpace(stored.Value))
            {
                currentTheme = stored.Value!;
            }
        }
        catch { /* ignore */ }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var state = await AuthProvider.GetAuthenticationStateAsync();
                if (state.User?.Identity?.IsAuthenticated == true)
                {
                    redirecting = true;
                    StateHasChanged();
                    // Small delay for fade-in effect & to prevent login form flash
                    await Task.Delay(250);
                    Navigation.NavigateTo("/dashboard", replace: true);
                }
            }
            catch { /* ignore */ }
        }
    }

    private async Task ToggleTheme()
    {
        currentTheme = currentTheme == "dark" ? "light" : "dark";
        try { await LocalStorage.SetAsync("theme", currentTheme); } catch { /* ignore */ }
    }

    private async Task HandleLogin()
    {
        Logger.LogInformation("HandleLogin method called!");
        Console.WriteLine("HandleLogin method called!");
        
        try
        {
            // Clear previous messages
            errorMessage = null;
            successMessage = null;
            isLoading = true;
            StateHasChanged();

            var user = await AuthService.SingInUserAsync(signInRequest, CancellationToken.None);
            if (user is not null)
            {
                var token = AuthService.GenerateToken(user);
                var sw = System.Diagnostics.Stopwatch.StartNew();
                bool stored = false;
                try
                {
                    await LocalStorage.SetAsync("jwt", token);
                    stored = true;
                    Logger.LogInformation("JWT persisted via ProtectedLocalStorage in {Elapsed} ms", sw.ElapsedMilliseconds);
                }
                catch (Exception lsEx)
                {
                    Logger.LogWarning(lsEx, "ProtectedLocalStorage.SetAsync failed after {Elapsed} ms. Falling back to JS localStorage.", sw.ElapsedMilliseconds);
                }
                finally
                {
                    sw.Stop();
                }

                if (!stored)
                {
                    try
                    {
                        // Fallback: direct JS localStorage (non-protected) so user can proceed
                        await Microsoft.JSInterop.JSRuntimeExtensions.InvokeVoidAsync((Microsoft.JSInterop.IJSRuntime)Navigation.ToAbsoluteUri("/").GetType().GetProperty("JsRuntime", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance)?.GetValue(Navigation)!, "eval", $"localStorage.setItem('jwt', '{token.Replace("'", "\\'")}')");
                        Logger.LogInformation("JWT stored via JS localStorage fallback.");
                    }
                    catch (Exception jsEx)
                    {
                        Logger.LogError(jsEx, "Failed to store JWT via JS fallback");
                        errorMessage = "Login succeeded but storing session token failed.";
                    }
                }

                if (AuthProvider is JwtAuthStateProvider jwtProvider)
                {
                    jwtProvider.SetToken(token);
                }

                successMessage = "Login successful! Redirecting...";
                StateHasChanged();
                
                // Small delay to show success message
                await Task.Delay(1000);
                Navigation.NavigateTo("/dashboard");
            }
            else
            {
                errorMessage = "Invalid email or password. Please try again.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "An error occurred during login. Please try again later.";
            // Log the exception if you have a logging service
            Console.WriteLine($"Login error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

}