@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using ai.lab.service.Pages.Shared

<Router AppAssembly="@typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
            <NotAuthorized>
                @if (!notAuthorizedHandled)
                {
                    <p class="text-muted small m-3">Redirecting to login...</p>
                }
            </NotAuthorized>
            <Authorizing>
                <p class="text-muted m-3">Authorizing...</p>
            </Authorizing>
        </AuthorizeRouteView>
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(MainLayout)">
            <p>Sorry, nothing here!</p>
        </LayoutView>
    </NotFound>
</Router>

@code {
    [Inject] private ProtectedLocalStorage LocalStorage { get; set; } = default!;
    [Inject] private AuthenticationStateProvider AuthProvider { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;
    private bool notAuthorizedHandled;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // When a user hits a protected route without auth, clear any stale token once.
        if (!notAuthorizedHandled)
        {
            var state = await AuthProvider.GetAuthenticationStateAsync();
            if (state.User?.Identity?.IsAuthenticated != true)
            {
                try { await LocalStorage.DeleteAsync("jwt"); } catch { }
                if (AuthProvider is JwtAuthStateProvider jwt)
                {
                    jwt.SetToken(string.Empty);
                }
                notAuthorizedHandled = true;
                StateHasChanged();
                Nav.NavigateTo("/login", true);
            }
        }
    }
}