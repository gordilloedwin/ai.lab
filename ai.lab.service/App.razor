@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Authorization
@using ai.lab.service.Pages.Shared

<CascadingAuthenticationState>
	<Router AppAssembly="typeof(Program).Assembly">
		<Found Context="rd">
			<AuthorizeRouteView RouteData="rd" DefaultLayout="typeof(Layout)">
				<Authorizing>
					<div style="display:flex; justify-content:center; align-items:center; height:100vh; flex-direction:column; gap:1rem;">
						<div style="font-size:1.5rem; color:var(--color-text-muted);">Loading...</div>
						<div style="font-size:0.875rem; color:var(--color-text-faint);">Verifying authentication</div>
					</div>
				</Authorizing>
				<NotAuthorized>
					<div style="display:flex; justify-content:center; align-items:center; height:100vh; flex-direction:column; gap:1rem;">
						<h3 style="margin:0; color:var(--color-text);">Access Denied</h3>
						<p style="margin:0; color:var(--color-text-muted);">You must be logged in to access this page.</p>
						<a href="/" style="color:var(--color-primary); text-decoration:underline;">Go to Login</a>
					</div>
				</NotAuthorized>
			</AuthorizeRouteView>
		</Found>
		<NotFound>
			<LayoutView Layout="typeof(Layout)">
				<div style="display:flex; justify-content:center; align-items:center; height:100vh; flex-direction:column; gap:1rem;">
					<h3 style="margin:0; color:var(--color-text);">Page not found</h3>
					<a href="/" style="color:var(--color-primary); text-decoration:underline;">Home</a>
				</div>
			</LayoutView>
		</NotFound>
	</Router>
</CascadingAuthenticationState>